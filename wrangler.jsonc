{
  // Bull Stock trên Cloudflare Workers (giao diện tĩnh + API Express).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiennguyen",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "assets": {
    "directory": "client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Thư mục Blob "prod" cho bản chính; bản xem thử ghi đè bằng --var VERCEL_ENV:preview
  "vars": { "VERCEL_ENV": "production" },
  "observability": { "enabled": true }
}
