# Which data provider to use: kbs | vnstock | tradingview | fireant | vndirect | mock | yahoo | alphavantage | finnhub
# kbs         = KB Securities — the current default of vnstock's own unified
#               Market/Fundamental classes (vnstocks.com). No token needed.
# vnstock     = older VCI (Vietcap)-based endpoints, kept for fallback. No token needed.
# tradingview = TradingView's public Vietnam scanner (no token needed)
# fireant     = FireAnt (needs FIREANT_TOKEN below)
# vndirect    = VNDirect (no token needed)
# mock        = offline fake data, useful when developing without internet access
DATA_PROVIDER=kbs

# Required only when DATA_PROVIDER=fireant.
# Log in at https://fireant.vn, open DevTools > Network, find any request to
# restv2.fireant.vn and copy the "Authorization: Bearer <token>" value here
# (paste only the token part, without the word "Bearer").
FIREANT_TOKEN=

# Optional (fireant only): FireAnt returns prices in thousand-VND. We scale up
# by 1000 by default; set to 1 if prices look 1000x wrong.
FIREANT_PRICE_SCALE=1000

# Required only when DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=

# Required only when DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# Comma-separated symbols to show on /api/market/overview.
# Defaults to the curated VN universe in providers/universe.ts.
WATCHLIST_SYMBOLS=

# Optional: durable storage for the daily digest ("Bản tin") article
# history, via Upstash Redis — see server/src/digest/digestStore.ts. Without
# these, digest history is kept in memory only and is lost on every
# server restart / redeploy. On Vercel, add a "Redis" storage integration
# from the Marketplace (Storage tab) — it injects these automatically
# (under either this name or the legacy KV_REST_API_URL/KV_REST_API_TOKEN,
# both are read).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=4000
