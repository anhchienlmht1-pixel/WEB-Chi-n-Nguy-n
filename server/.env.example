# Which data provider to use: vndirect | mock | yahoo | alphavantage | finnhub
# vndirect = real Vietnam market data (VNDirect Securities, no API key needed)
# mock     = offline fake data, useful when developing without internet access
DATA_PROVIDER=vndirect

# Required only when DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=

# Required only when DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# Comma-separated symbols to show on /api/market/overview.
# For vndirect/mock, defaults to the curated VN universe in providers/universe.ts.
# For yahoo/alphavantage/finnhub (non-VN providers), defaults to a handful of US tickers.
WATCHLIST_SYMBOLS=

PORT=4000
