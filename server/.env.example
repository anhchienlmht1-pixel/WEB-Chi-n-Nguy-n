# Which data provider to use: mock | yahoo | alphavantage | finnhub
DATA_PROVIDER=mock

# Required only when DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=

# Required only when DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# Comma-separated symbols used by /api/market/overview for real providers
WATCHLIST_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,NFLX

PORT=4000
