# Which data provider to use: tradingview | fireant | vndirect | mock | yahoo | alphavantage | finnhub
# tradingview = real Vietnam market data from TradingView's public scanner (no token needed)
# fireant     = real Vietnam market data from FireAnt (needs FIREANT_TOKEN below)
# vndirect    = real Vietnam market data from VNDirect (no token needed)
# mock        = offline fake data, useful when developing without internet access
DATA_PROVIDER=tradingview

# Required only when DATA_PROVIDER=fireant.
# Log in at https://fireant.vn, open DevTools > Network, find any request to
# restv2.fireant.vn and copy the "Authorization: Bearer <token>" value here
# (paste only the token part, without the word "Bearer").
FIREANT_TOKEN=

# Optional (fireant only): FireAnt returns prices in thousand-VND. We scale up
# by 1000 by default; set to 1 if prices look 1000x wrong.
FIREANT_PRICE_SCALE=1000

# Required only when DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=

# Required only when DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# Comma-separated symbols to show on /api/market/overview.
# Defaults to the curated VN universe in providers/universe.ts.
WATCHLIST_SYMBOLS=

PORT=4000
